      "code_nomenclature_type": "AIGLE_COMPORTEMENT_DOMAINE_VITAL",
      "type_util": "nomenclature",
      "multi_select": true
    },
    "nb_jeune_seul": {
      "type_widget": "number",
      "attribut_label": "Nombre de jeune seul",
      "required": false,
      "min": 0,
      "max": 20
    },
    "nb_jeune_avec_adulte": {
      "type_widget": "number",
      "attribut_label": "Nombre de jeune avec adulte",
      "required": false,
      "min": 0,
      "max": 20
    },
    "statut_reproduction": {
      "type_widget": "nomenclature",
      "attribut_label": "Statut de reproduction:",
      "code_nomenclature_type": "AIGLE_STATUT_REPRODUCTION",
      "type_util": "nomenclature"
